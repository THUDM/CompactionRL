+    eps_clip_high: float,
+):
+    ratio = (-ppo_kl).exp().detach()
+    ratio = ratio.clamp(0.5, 2)
+    delta = log_probs.exp().detach() - old_log_probs.exp().detach()
+
+    adv_mask = (advantages > 0).float()
+    eps_matrix = torch.full_like(advantages, eps_clip_high) * adv_mask + (1 - adv_mask) * torch.full_like(advantages, eps_clip)
+    violation = delta.abs() > eps_matrix
+
+    clipped_multiplier = (~violation).to(dtype=advantages.dtype)
+    pg_losses = -clipped_multiplier * ratio * advantages * log_probs
+    clipfrac = violation.to(dtype=advantages.dtype).detach()
+    return pg_losses, clipfrac
+
