+# CompactionRL: masked token GAE and the optional historical stepwise variant.
+
+def mask_chunks(mask, max_chunk_size=-1):
+    """Split consecutive equal mask values, optionally limiting each run's size."""
+    if mask.ndim != 1 or not mask.numel() or not ((mask == 0) | (mask == 1)).all():
+        raise ValueError("Expected a nonempty binary response mask")
+    boundaries = [
+        0,
+        *(mask[1:] != mask[:-1]).nonzero().flatten().add(1).tolist(),
+        len(mask),
+    ]
+    spans = []
+    for start, end in zip(boundaries, boundaries[1:]):
+        size = max_chunk_size if max_chunk_size > 0 else end - start
+        spans.extend((i, min(i + size, end)) for i in range(start, end, size))
+    return spans
+
+
+def stepwise_value_mask(mask, max_chunk_size=-1):
+    result = torch.zeros_like(mask)
+    for start, end in mask_chunks(mask, max_chunk_size):
+        if mask[start] == 1:
+            result[end - 1] = 1
+    return result
+
+
+@torch.no_grad()
+def stepwise_segment_gae(
+    values,
+    mask,
+    reward,
+    later_tokens,
+    gamma=1.0,
+    lambd=None,
+    alpha=1.5,
+    enabled=True,
+    max_chunk_size=-1,
+    value_type="last_token",
+):
+    """Use one value per generated run and broadcast its advantage to that run.
+
+    The development implementation's adaptive lambda counts all mask chunks,
+    including observations, while the recurrence advances on generated chunks.
+    This optional variant preserves that convention; it differs from token GAE.
+    """
+    if (
+        values.ndim != 1
+        or values.shape != mask.shape
+        or not mask.any()
+        or later_tokens < 0
+    ):
+        raise ValueError(
+            "Expected aligned nonempty generated tokens and nonnegative N_after"
+        )
+    if value_type not in {"last_token", "step_average"}:
+        raise ValueError(f"Unknown stepwise value type: {value_type}")
+    spans = mask_chunks(mask, max_chunk_size)
+    lam = 1 - 1 / (alpha * len(spans)) if lambd is None else float(lambd)
+    if not 0 <= lam <= 1 or not 0 <= gamma <= 1:
+        raise ValueError("Invalid stepwise discount factor")
+    advantage = torch.zeros_like(values, dtype=torch.float32)
+    returns = torch.zeros_like(advantage)
+    tail = values.new_zeros((), dtype=torch.float32)
+    next_value = values.new_zeros((), dtype=torch.float32)
+    terminal = True
+    for start, end in reversed(spans):
+        if mask[start] == 0:
+            continue
+        chunk = values[start:end].float()
+        current = chunk[-1] if value_type == "last_token" else chunk.mean()
+        tail = (
+            (reward if terminal else 0.0)
+            + gamma * next_value
+            - current
+            + gamma * lam * tail
+        )
+        advantage[start:end] = tail
+        next_value = current
+        terminal = False
+    if enabled:
+        advantage *= (gamma * lam) ** int(later_tokens)
+    returns[mask.bool()] = (advantage + values.float())[mask.bool()]
+    return advantage, returns
+
+
+def masked_segment_gae(
+    values, mask, reward, later_tokens, gamma=1.0, lambd=None, alpha=1.5, enabled=True
+):
+    if values.ndim != 1 or values.shape != mask.shape:
+        raise ValueError("Expected aligned one-dimensional values and mask")
+    positions = mask.bool().nonzero(as_tuple=True)[0]
+    count = positions.numel()
+    if not count or later_tokens < 0:
+        raise ValueError("Empty segment or negative subsequent token count")
+    lam = 1 - 1 / (alpha * count) if lambd is None else float(lambd)
+    if not 0 <= lam <= 1 or not 0 <= gamma <= 1:
+        raise ValueError("Invalid discount factor")
+    selected = values[positions].float()
+    advantage = torch.empty_like(selected)
+    tail = torch.zeros((), device=values.device)
+    for i in range(count - 1, -1, -1):
+        next_value = selected[i + 1] if i + 1 < count else 0.0
+        r = reward if i == count - 1 else 0.0
+        tail = r + gamma * next_value - selected[i] + gamma * lam * tail
+        advantage[i] = tail
+    if enabled:
+        advantage *= (gamma * lam) ** int(later_tokens)
+    full_adv = torch.zeros_like(values, dtype=torch.float32)
+    full_ret = torch.zeros_like(values, dtype=torch.float32)
+    full_adv[positions] = advantage
+    full_ret[positions] = advantage + selected
+    return full_adv, full_ret
+
+
+@torch.no_grad()
+def compute_compaction_advantages(args, rollout_data, is_policy=True):
+    from megatron.core import mpu
+    from slime.backends.megatron_utils.cp_utils import (
+        all_gather_with_cp,
+        slice_log_prob_with_cp,
+    )
+
+    if args.kl_coef != 0:
+        raise ValueError("This paper recipe uses KL coefficient zero")
+    metadata = rollout_data.get("metadata")
+    if metadata is None or len(metadata) != len(rollout_data["values"]):
+        raise ValueError(
+            "Missing segment metadata: cross-segment correction cannot be computed"
+        )
+    advantages, returns, rewards = [], [], []
+    stepwise = getattr(args, "use_step_level_advantage", False)
+    value_masks = []
+    cp_size = mpu.get_context_parallel_world_size()
+    for i, local_values in enumerate(rollout_data["values"]):
+        total = rollout_data["total_lengths"][i]
+        length = rollout_data["response_lengths"][i]
+        full_values = (
+            all_gather_with_cp(local_values, total, length)
+            if cp_size > 1
+            else local_values
+        )
+        mask = torch.as_tensor(rollout_data["loss_masks"][i], device=full_values.device)
+        if len(mask) != length:
+            raise ValueError("Expected full response loss mask before CP slicing")
+        meta = metadata[i]
+        if int(mask.sum()) != meta["optimized_tokens"]:
+            raise ValueError("Training mask changed after N_after was computed")
+        lam = (
+            None
+            if is_policy and args.use_length_adaptive_gae
+            else (args.lambd if is_policy else args.lambd_critic)
+        )
+        estimator = masked_segment_gae
+        extra = {}
+        if stepwise:
+            estimator = stepwise_segment_gae
+            extra = dict(
+                max_chunk_size=args.critic_stepwise_max_chunk_size,
+                value_type=args.stepwise_advantage_type,
+            )
+            if not is_policy and args.stepwise_advantage_type == "last_token":
+                value_masks.append(
+                    stepwise_value_mask(mask, args.critic_stepwise_max_chunk_size)
+                )
+        adv, ret = estimator(
+            full_values,
+            mask,
+            float(rollout_data["rewards"][i]),
+            int(meta["later_assistant_tokens"]),
+            gamma=args.gamma,
+            lambd=lam,
+            alpha=args.length_adaptive_alpha,
+            enabled=args.compaction_advantage_mode == "gae",
+            **extra,
+        )
+        reward_tensor = torch.zeros_like(full_values)
+        reward_tensor[mask.nonzero(as_tuple=True)[0][-1]] = float(
+            rollout_data["rewards"][i]
+        )
+        if cp_size > 1:
+            adv, ret, reward_tensor = [
+                slice_log_prob_with_cp(x, total, length)
+                for x in (adv, ret, reward_tensor)
+            ]
+        advantages.append(adv)
+        returns.append(ret)
+        rewards.append(reward_tensor)
+    rollout_data.update(advantages=advantages, returns=returns, token_rewards=rewards)
+    if value_masks:
+        rollout_data["value_loss_masks"] = value_masks
+    else:
+        rollout_data.pop("value_loss_masks", None)
+
+
+@torch.no_grad()
+def group_estimate(args, rollout_data, is_policy=True):
+    """SUPO-style baseline: one rollout-relative advantage for every segment token."""
+    from megatron.core import mpu
+    from slime.backends.megatron_utils.cp_utils import slice_log_prob_with_cp
+
+    advantages = []
+    for i, meta in enumerate(rollout_data["metadata"]):
+        if meta.get("group_size", 0) < 2 or "group_advantage" not in meta:
+            raise ValueError("Missing independent-rollout group advantage")
+        reference = (
+            rollout_data.get("log_probs")
+            or rollout_data.get("rollout_log_probs")
+            or rollout_data.get("values")
+        )
+        if not reference:
+            raise ValueError("Missing model tensors for group advantage placement")
+        mask = torch.as_tensor(
+            rollout_data["loss_masks"][i], device=reference[i].device
+        )
+        advantage = mask.float() * float(meta["group_advantage"])
+        if mpu.get_context_parallel_world_size() > 1:
+            advantage = slice_log_prob_with_cp(
+                advantage,
+                rollout_data["total_lengths"][i],
+                rollout_data["response_lengths"][i],
+            )
+        advantages.append(advantage)
+    rollout_data.update(advantages=advantages, returns=advantages)
